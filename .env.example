# 复制为 .env 使用：cp .env.example .env
# compose 会自动读取同目录的 .env 做变量替换（${VAR:-默认值}）。

# MySQL root 密码，仅容器首次初始化和 healthcheck 使用
MYSQL_ROOT_PASSWORD=root

# 业务库名 + 业务账号（首次初始化时自动创建并授权，Go 服务用这套连接）
MYSQL_DB_NAME=ecom_admin
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123

# JWT 密钥：开发默认值。user-service 签发、api-gateway 校验，两边必须一致。
# 生产环境务必换成强随机值，且绝不提交进仓库。
JWT_SECRET=dev-only-change-me-in-production

# 宿主机端口映射：本机 3306/8080 被占用时改这里
MYSQL_HOST_PORT=3306
GATEWAY_HOST_PORT=8080

# RocketMQ（阶段 6）：Proxy 的 gRPC 端口（宿主机裸 go run 用）与
# 控制台端口（make mq-dashboard 后 http://localhost:18080）
ROCKETMQ_PROXY_HOST_PORT=8081
ROCKETMQ_DASHBOARD_HOST_PORT=18080
